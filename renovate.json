{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:ci|release|prerelease-dry-run)\\.yml$/"
      ],
      "matchStrings": [
        "GO_VERSION_CURRENT:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the asdf and GitHub Actions Go toolchains synchronized",
      "matchDepNames": [
        "golang"
      ],
      "groupName": "Go toolchain"
    },
    {
      "description": "Actionlint upgrades require an explicit Go 1.22 compatibility review for both the bootstrap binary and workflow guard module",
      "matchDepNames": [
        "github.com/rhysd/actionlint"
      ],
      "enabled": false
    }
  ]
}
